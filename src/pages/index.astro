---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Plans from '../components/Plans.astro';
import Programs from '../components/Programs.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import WhatsAppDialog from '../components/WhatsAppDialog.astro';
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Plans />
    <Programs />
    <Testimonials />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
  <FloatingContact />
  <WhatsAppDialog />
</Base>

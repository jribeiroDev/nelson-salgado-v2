---
import Icon from './Icon.astro';

interface Props {
  /** id da lista .snap-row a controlar */
  target: string;
  label: string;
}
const { target, label } = Astro.props;
---

<div class="mt-4 hidden justify-center gap-3 md:flex" data-carousel-controls={target}>
  <button
    type="button"
    data-dir="-1"
    aria-controls={target}
    aria-label={`${label}: anterior`}
    class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full border border-darkblue/15 bg-white text-darkblue shadow-sm transition hover:bg-gold disabled:cursor-default disabled:opacity-40 disabled:hover:bg-white"
  >
    <Icon name="chevron-left" />
  </button>
  <button
    type="button"
    data-dir="1"
    aria-controls={target}
    aria-label={`${label}: seguinte`}
    class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full border border-darkblue/15 bg-white text-darkblue shadow-sm transition hover:bg-gold disabled:cursor-default disabled:opacity-40 disabled:hover:bg-white"
  >
    <Icon name="chevron-right" />
  </button>
</div>

<script>
  for (const controls of document.querySelectorAll<HTMLElement>('[data-carousel-controls]')) {
    const row = document.getElementById(controls.dataset.carouselControls!);
    if (!row) continue;
    const [prev, next] = controls.querySelectorAll<HTMLButtonElement>('button');

    const update = () => {
      prev.disabled = row.scrollLeft <= 2;
      next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 2;
    };

    controls.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-dir]');
      if (!button) return;
      row.scrollBy({ left: Number(button.dataset.dir) * row.clientWidth * 0.85 });
    });
    row.addEventListener('scroll', update, { passive: true });
    // Só mede quando os controlos ficam visíveis: ler scrollWidth no arranque forçaria
    // o layout síncrono das secções com content-visibility (bloqueia o main thread).
    new IntersectionObserver((entries, observer) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        update();
        observer.disconnect();
      }
    }).observe(controls);
  }
</script>

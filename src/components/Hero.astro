---
import { Picture } from 'astro:assets';
import site from '../content/site.json';
import hero1 from '../assets/hero/hero-1.jpeg';
import hero2 from '../assets/hero/hero-2.jpeg';
import hero3 from '../assets/hero/hero-3.jpeg';
import hero4 from '../assets/hero/hero-4.jpeg';

const images = [
  { src: hero1, alt: 'Aluna em treino de mobilidade e alongamento' },
  { src: hero2, alt: 'Atleta em treino de força com barra' },
  { src: hero3, alt: 'Aluna em treino funcional ao ar livre' },
  { src: hero4, alt: 'Atleta em treino de musculação com halteres' },
];
---

<section class="relative isolate flex min-h-svh w-full items-center overflow-hidden bg-darkblue">
  <div class="absolute inset-0 -z-10 grid grid-cols-2 grid-rows-2 sm:grid-cols-4 sm:grid-rows-1">
    {
      images.map((img) => (
        <Picture
          src={img.src}
          alt={img.alt}
          formats={['avif', 'webp']}
          width={480}
          height={1000}
          fit="cover"
          position="attention"
          widths={[200, 280, 360, 400, 480]}
          sizes="(min-width: 640px) max(25vw, 48vh), max(50vw, 24vh)"
          quality={55}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
          pictureAttributes={{ class: 'block h-full min-h-0 w-full overflow-hidden' }}
        />
      ))
    }
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/60 via-black/45 to-black/70"></div>

  <div class="mx-auto flex w-full max-w-5xl flex-col items-center px-4 pt-20 pb-24 text-center sm:px-6 lg:px-8">
    <h1 class="text-white">
      <span class="mb-3 block text-sm font-semibold tracking-[0.2em] text-gold uppercase sm:text-base">
        {site.hero.eyebrow}
      </span>
      <span class="block text-4xl leading-tight font-bold text-balance sm:text-5xl md:text-6xl lg:text-7xl">
        {site.hero.title}
      </span>
    </h1>
    <p class="mt-5 max-w-2xl text-base text-pretty text-white/85 sm:text-lg">{site.hero.subtitle}</p>

    <a href="#planos" class="btn-gold mt-8 uppercase">{site.hero.cta}</a>

    <ul class="mt-10 grid w-full max-w-3xl grid-cols-3 gap-3 sm:mt-14 sm:gap-6">
      {
        site.stats.map((stat) => (
          <li class="rounded-xl border border-white/20 bg-white/10 p-3 text-center backdrop-blur-sm sm:p-5">
            <p class="text-2xl font-bold text-gold sm:text-3xl lg:text-4xl">{stat.value}</p>
            <p class="mt-1 text-[0.65rem] tracking-wide text-white/85 uppercase sm:text-sm">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

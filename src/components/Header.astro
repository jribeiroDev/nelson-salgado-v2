---
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';

const nav = [
  { href: '#planos', label: 'Planos' },
  { href: '#programas', label: 'Programas' },
  { href: '#testemunhos', label: 'Testemunhos' },
  { href: '#faq', label: 'FAQ' },
];
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-30 text-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:h-20 sm:px-6 lg:px-8">
    <a href="/" class="text-lg font-extrabold tracking-tight sm:text-xl">
      Nelson <span class="text-gold">Salgado</span>
    </a>
    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex gap-8 text-[0.95rem] font-semibold">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="opacity-85 transition hover:text-gold hover:opacity-100">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <WhatsAppLink class="btn-gold min-h-10 px-4 py-2 text-sm">
      <Icon name="whatsapp" class="size-4" /> Começar
    </WhatsAppLink>
  </div>
</header>

<script>
  // Header transparente sobre o hero, sólido depois: observa um "sentinela" no topo
  // da página (IntersectionObserver não força layout, ao contrário de scroll listeners).
  const header = document.getElementById('site-header')!;
  const sentinel = document.getElementById('hero-sentinel');
  if (sentinel) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>

---
import Icon from './Icon.astro';
---

<dialog id="wa-dialog" class="modal" aria-labelledby="wa-dialog-title" aria-describedby="wa-dialog-desc">
  <form id="wa-form" method="dialog" novalidate>
    <!-- Cabeçalho tipo "conversa" com o Nelson -->
    <div class="relative overflow-hidden bg-gradient-to-br from-blue to-darkblue px-5 pt-5 pb-4 text-white sm:px-8 sm:pt-6 sm:pb-5">
      <div class="absolute -top-16 -right-10 size-44 rounded-full bg-gold/25 blur-3xl" aria-hidden="true"></div>
      <button
        type="button"
        id="wa-close"
        class="absolute top-3 right-3 inline-flex size-10 cursor-pointer items-center justify-center rounded-full text-white/80 transition hover:bg-white/10 hover:text-white"
        aria-label="Fechar"
      >
        <Icon name="close" />
      </button>
      <div class="relative flex items-center gap-3">
        <span class="relative inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-darkblue text-base font-extrabold text-gold ring-2 ring-gold/60">
          NS
          <span class="absolute -right-0.5 -bottom-0.5 inline-flex size-5 items-center justify-center rounded-full bg-whatsapp text-white ring-2 ring-darkblue">
            <Icon name="whatsapp" class="size-3" />
          </span>
        </span>
        <span>
          <span class="block font-bold">Nelson Salgado</span>
          <span class="block text-sm text-white/70">Personal Trainer · WhatsApp</span>
        </span>
      </div>
    </div>

    <div class="px-5 pt-5 pb-6 sm:px-8 sm:pt-6 sm:pb-7">
      <h2 id="wa-dialog-title" class="text-2xl leading-tight font-bold text-darkblue">Pronto para começar? 💪</h2>
      <p id="wa-dialog-desc" class="mt-1.5 text-[0.95rem] text-darkblue/70">
        <!-- Diz-nos o teu nome e abrimos o WhatsApp com a mensagem pronta. Só tens de enviar. -->
      </p>

      <p
        id="wa-interest"
        class="mt-4 hidden items-center gap-2 rounded-xl bg-gold/15 px-3.5 py-2.5 text-sm text-darkblue"
      >
        <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-gold text-ink">
          <Icon name="check" class="size-4" />
        </span>
        <span>Escolheste: <strong id="wa-interest-name" class="font-bold"></strong></span>
      </p>

      <label for="wa-name" class="mt-4 block text-sm font-semibold text-darkblue">Como te chamas?</label>
      <input
        id="wa-name"
        name="name"
        type="text"
        required
        minlength="2"
        maxlength="40"
        autocomplete="given-name"
        autocapitalize="words"
        enterkeyhint="send"
        placeholder="Nome"
        aria-describedby="wa-error"
        class="mt-2 block w-full rounded-2xl border border-darkblue/15 bg-beige/60 px-4 py-3 text-base text-darkblue outline-none transition placeholder:text-darkblue/40 focus:border-blue focus:bg-white focus:ring-4 focus:ring-blue/15 aria-invalid:border-red-500 aria-invalid:ring-red-500/15"
      />
      <p id="wa-error" class="mt-2 hidden text-sm font-medium text-red-600" role="alert">
        Preenche o teu nome para continuar. 
      </p>

      <button type="submit" class="btn mt-6 w-full bg-whatsapp text-base text-ink shadow-[0_12px_30px_-12px_rgb(37_211_102/0.9)] hover:-translate-y-0.5 hover:brightness-95">
        <Icon name="whatsapp" /> Abrir conversa no WhatsApp
      </button>

      <ul class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs font-medium text-darkblue/70">
        <li class="inline-flex items-center gap-1"><Icon name="check" class="size-3.5 text-[#1da851]" /> Sem compromisso</li>
        <li class="inline-flex items-center gap-1"><Icon name="check" class="size-3.5 text-[#1da851]" /> Falas com o Nelson</li>
        <li class="inline-flex items-center gap-1"><Icon name="check" class="size-3.5 text-[#1da851]" /> Plano à tua medida</li>
      </ul>
    </div>
  </form>
</dialog>

<script>
  import { buildMessage, buildWhatsAppUrl } from '../lib/whatsapp';

  const dialog = document.getElementById('wa-dialog') as HTMLDialogElement;
  const form = document.getElementById('wa-form') as HTMLFormElement;
  const input = document.getElementById('wa-name') as HTMLInputElement;
  const error = document.getElementById('wa-error') as HTMLParagraphElement;
  const interestBox = document.getElementById('wa-interest') as HTMLParagraphElement;
  const interestName = document.getElementById('wa-interest-name') as HTMLElement;
  const STORAGE_KEY = 'wa-name';
  let interest: string | undefined;

  const setError = (show: boolean) => {
    error.classList.toggle('hidden', !show);
    input.setAttribute('aria-invalid', String(show));
  };

  // Delegação: qualquer link [data-wa] abre este diálogo em vez de ir direto ao WhatsApp.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-wa]');
    if (!link || event.ctrlKey || event.metaKey || event.shiftKey) return;
    event.preventDefault();
    interest = link.dataset.interest || undefined;
    interestName.textContent = interest ?? '';
    interestBox.classList.toggle('hidden', !interest);
    interestBox.classList.toggle('flex', !!interest);
    try {
      if (!input.value) input.value = localStorage.getItem(STORAGE_KEY) ?? '';
    } catch {}
    setError(false);
    // Fecha o diálogo de detalhes do programa (se aberto) antes de abrir este.
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((open) => open.close());
    dialog.showModal();
    input.focus();
  });

  input.addEventListener('input', () => {
    if (input.value.trim().length >= 2) setError(false);
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const name = input.value.trim();
    if (name.length < 2) {
      setError(true);
      input.focus();
      return;
    }
    try {
      localStorage.setItem(STORAGE_KEY, name);
    } catch {}
    const url = buildWhatsAppUrl(buildMessage(name, interest));
    const win = window.open(url, '_blank');
    if (win) win.opener = null;
    else location.href = url; // pop-up bloqueado → abre na mesma janela
    dialog.close();
  });

  document.getElementById('wa-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

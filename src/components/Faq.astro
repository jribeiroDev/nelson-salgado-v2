---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';

const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<section id="faq" class="defer-render bg-white px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow">FAQ</p>
      <h2 class="section-title">Perguntas Frequentes</h2>
      <p class="section-lead">Esclarecemos as tuas principais dúvidas</p>
      <WhatsAppLink class="btn-outline mt-8">
        <Icon name="whatsapp" class="size-5 text-[#1da851]" /> Fala connosco
      </WhatsAppLink>
    </div>

    <div class="divide-y divide-darkblue/10 border-y border-darkblue/10">
      {
        faq.map(({ data: item }, i) => (
          <details name="faq" class="group" open={i === 0}>
            <summary class="flex items-center justify-between gap-6 py-6 text-left">
              <h3 class="text-lg font-bold text-darkblue transition group-hover:text-blue sm:text-xl">
                {item.question}
              </h3>
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-beige text-darkblue transition group-open:bg-darkblue group-open:text-gold">
                <Icon name="plus" class="details-icon size-5 transition-transform duration-300" />
              </span>
            </summary>
            <p class="max-w-prose pr-16 pb-6 text-darkblue/75">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

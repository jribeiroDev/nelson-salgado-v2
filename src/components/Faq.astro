---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<section id="faq" class="defer-render scroll-mt-4 bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-3xl">
    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title">Perguntas Frequentes</h2>
      <p class="mt-3 text-lg text-blue sm:text-xl">Esclarecemos as tuas principais dúvidas</p>
    </div>

    <div class="space-y-4">
      {
        faq.map(({ data: item }) => (
          <details name="faq" class="group rounded-xl bg-beige shadow-sm transition-shadow open:shadow-md">
            <summary class="flex min-h-14 items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-blue sm:px-6">
              <h3 class="text-base sm:text-lg">{item.question}</h3>
              <Icon name="plus" class="details-icon size-5 shrink-0 transition-transform" />
            </summary>
            <p class="px-5 pb-5 text-darkblue/80 sm:px-6">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

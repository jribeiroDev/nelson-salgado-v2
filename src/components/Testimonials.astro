---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
// A faixa é duplicada para o loop infinito (translate -50%). A cópia é escondida de
// leitores de ecrã/teclado (aria-hidden + inert) para não repetir conteúdo.
const copies = [false, true];
---

<section id="testemunhos" class="defer-render overflow-hidden bg-beige py-20 sm:py-24 lg:py-32">
  <svg class="hidden" aria-hidden="true">
    <symbol id="star" viewBox="0 0 24 24">
      <path fill="currentColor" d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
    </symbol>
  </svg>
  <div class="reveal mx-auto max-w-2xl px-4 text-center sm:px-6">
    <p class="eyebrow">Testemunhos</p>
    <h2 class="section-title">O que dizem os nossos clientes</h2>
  </div>

  <div class="marquee mt-14" style={`--marquee-duration: ${testimonials.length * 9}s`}>
    <ul class="marquee-track" aria-label="Testemunhos de alunos">
      {
        copies.map((isCopy) =>
          testimonials.map(({ data: t }) => (
            <li class="me-6 w-[19rem] shrink-0 sm:w-[23rem]" aria-hidden={isCopy ? 'true' : undefined} inert={isCopy}>
              <figure class="flex h-full flex-col rounded-3xl bg-white p-7 shadow-[0_20px_40px_-30px_rgb(31_47_63/0.4)] ring-1 ring-darkblue/5">
                <div class="flex items-center justify-between">
                  <Icon name="quote" class="size-8 text-gold/70" />
                  <svg class="h-4 w-[5.5rem] text-gold" viewBox="0 0 120 24" role="img" aria-label="5 estrelas">
                    <use href="#star" width="24" height="24" />
                    <use href="#star" x="24" width="24" height="24" />
                    <use href="#star" x="48" width="24" height="24" />
                    <use href="#star" x="72" width="24" height="24" />
                    <use href="#star" x="96" width="24" height="24" />
                  </svg>
                </div>
                <blockquote class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-darkblue/80">
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-darkblue/10 pt-5">
                  <Image
                    src={t.photo}
                    alt={isCopy ? '' : `Fotografia de ${t.name}`}
                    width={48}
                    height={48}
                    densities={[1, 2]}
                    format="webp"
                    quality={70}
                    loading="lazy"
                    decoding="async"
                    class="size-12 shrink-0 rounded-full object-cover ring-2 ring-gold ring-offset-2"
                  />
                  <span>
                    <span class="block font-bold text-darkblue">{t.name}</span>
                    <span class="block text-sm text-blue">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>

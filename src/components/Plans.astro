---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';

const plans = (await getCollection('plans')).sort((a, b) => a.data.order - b.data.order);
---

<section id="planos" class="relative overflow-hidden bg-beige px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
  <div
    class="pointer-events-none absolute -top-40 left-1/2 size-[40rem] -translate-x-1/2 rounded-full bg-white/60 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Planos</p>
      <h2 class="section-title">Acompanhamentos Premium</h2>
      <p class="section-lead">Escolhe o teu compromisso!</p>
    </div>

    <ul class="mt-14 grid gap-8 lg:mt-20 lg:grid-cols-3 lg:items-stretch lg:gap-5">
      {
        plans.map(({ data: plan }) => (
          <li
            class:list={[
              'reveal relative flex flex-col rounded-3xl p-7 pb-8 sm:p-9',
              plan.popular
                ? 'order-first bg-gradient-to-b from-blue to-darkblue text-white shadow-[0_30px_60px_-20px_rgb(31_47_63/0.6)] ring-2 ring-gold lg:order-none lg:-my-6 lg:py-12'
                : 'bg-white shadow-[0_20px_50px_-30px_rgb(31_47_63/0.35)] ring-1 ring-darkblue/5',
            ]}
          >
            {plan.popular && (
              <p class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-gold px-4 py-1 text-xs font-bold tracking-wider whitespace-nowrap text-ink uppercase shadow-lg">
                Mais popular
              </p>
            )}
            <h3 class:list={['text-lg font-bold', plan.popular ? 'text-gold' : 'text-blue']}>{plan.name}</h3>
            <p class="mt-4 flex items-end gap-1.5">
              <span class="text-6xl leading-none font-bold">{plan.price}€</span>
              <span class:list={['pb-1.5 text-base', plan.popular ? 'text-white/75' : 'text-darkblue/70']}>
                /{plan.period}
              </span>
            </p>
            <p class:list={['mt-4 text-[0.95rem]', plan.popular ? 'text-white/80' : 'text-darkblue/70']}>
              {plan.tagline}
            </p>

            <div class:list={['my-7 h-px shrink-0', plan.popular ? 'bg-white/20' : 'bg-darkblue/10']} />

            <ul class="mb-8 flex-1 space-y-3.5 text-[0.95rem]">
              {plan.includesPrevious && <li class="font-semibold">{plan.includesPrevious}</li>}
              {plan.benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <span
                    class:list={[
                      'mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full',
                      plan.popular ? 'bg-gold/20 text-gold' : 'bg-blue/10 text-blue',
                    ]}
                  >
                    <svg class="size-3" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m5 12 5 5L20 7"
                      />
                    </svg>
                  </span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>

            <WhatsAppLink interest={plan.name} class={plan.popular ? 'btn-gold mt-auto w-full shrink-0' : 'btn-dark mt-auto w-full shrink-0'}>
              Junta-te agora
              <Icon name="arrow-right" class="size-4" />
            </WhatsAppLink>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';

const plans = (await getCollection('plans')).sort((a, b) => a.data.order - b.data.order);
---

<section id="planos" class="scroll-mt-4 bg-beige px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title">Acompanhamentos Premium</h2>
      <p class="mt-3 text-lg text-blue sm:text-xl">Escolhe o teu compromisso!</p>
    </div>

    <ul class="grid items-stretch gap-6 lg:grid-cols-3 lg:gap-6">
      {
        plans.map(({ data: plan }) => (
          <li
            class:list={[
              'relative flex flex-col rounded-2xl p-6 shadow-lg sm:p-8',
              plan.popular
                ? 'order-first bg-gradient-to-br from-blue to-darkblue text-white shadow-2xl lg:order-none lg:-my-3'
                : 'border border-darkblue/10 bg-white',
            ]}
          >
            {plan.popular && (
              <p class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gold px-3 py-1 text-xs font-bold tracking-wide text-ink shadow">
                MAIS POPULAR
              </p>
            )}
            <h3 class="text-2xl font-bold">{plan.name}</h3>
            <p class="mt-4 flex items-baseline gap-1">
              <span class="text-5xl font-extrabold">{plan.price}€</span>
              <span class:list={['text-lg', plan.popular ? 'text-white/80' : 'text-darkblue/70']}>/{plan.period}</span>
            </p>
            <p class:list={['mt-3 text-sm', plan.popular ? 'text-white/85' : 'text-darkblue/75']}>{plan.tagline}</p>

            <ul class="mt-6 mb-8 flex-1 space-y-3 text-sm">
              {plan.includesPrevious && <li class="font-semibold">{plan.includesPrevious}</li>}
              {plan.benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <Icon
                    name="check"
                    class:list={['mt-px size-5 shrink-0', plan.popular ? 'text-gold' : 'text-emerald-600']}
                  />
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>

            <WhatsAppLink interest={plan.name} class={plan.popular ? 'btn-light' : 'btn-dark'}>
              Junta-te agora
            </WhatsAppLink>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<section class="defer-render bg-white px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8 lg:pb-32">
  <div
    class="reveal relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-gradient-to-br from-blue to-darkblue px-6 py-16 text-center text-white sm:px-12 sm:py-20"
  >
    <div class="absolute -top-24 -right-24 -z-10 size-72 rounded-full bg-gold/25 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-20 -z-10 size-80 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>

    <h2 class="mx-auto max-w-2xl text-3xl leading-tight font-extrabold text-balance sm:text-5xl">
      Pronto para começar a tua <span class="text-gold">transformação</span>?
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-white/80">
      Fala diretamente com o Nelson e descobre o plano certo para ti.
    </p>
    <WhatsAppLink class="btn-gold mt-9">
      <Icon name="whatsapp" /> Falar no WhatsApp
    </WhatsAppLink>
  </div>
</section>

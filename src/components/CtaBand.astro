---
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<section class="defer-render bg-gradient-to-br from-blue to-darkblue px-4 py-16 text-center text-white sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-3xl font-bold text-balance sm:text-4xl">Pronto para começar a tua transformação?</h2>
    <p class="mt-4 text-white/85">Fala diretamente com o Nelson e descobre o plano certo para ti.</p>
    <WhatsAppLink class="btn-gold mt-8">
      <Icon name="whatsapp" /> Falar no WhatsApp
    </WhatsAppLink>
  </div>
</section>

---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import CarouselControls from './CarouselControls.astro';

const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
---

<section id="programas" class="defer-render scroll-mt-4 bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title">Os Nossos Programas</h2>
      <p class="mt-3 text-lg text-blue sm:text-xl">Programas de treino com resultados em apenas 90 dias</p>
    </div>

    <ul id="programas-lista" class="snap-row items-start" aria-label="Programas de treino">
      {
        programs.map(({ id, data: p }) => (
          <li class="w-[82%] max-w-sm sm:w-80">
            <article
              id={id}
              class="flex h-full scroll-mt-6 flex-col overflow-hidden rounded-2xl border border-darkblue/10 bg-beige shadow-md"
            >
              <div class="relative aspect-[4/5] overflow-hidden">
                <Picture
                  src={p.image}
                  alt={p.imageAlt}
                  formats={['avif', 'webp']}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 640px) 320px, 82vw"
                  quality={60}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                  pictureAttributes={{ class: 'block h-full w-full' }}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent" />
                {p.popular && (
                  <p class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-full bg-gold px-2.5 py-1 text-xs font-bold text-ink">
                    <Icon name="star" class="size-3" /> Popular
                  </p>
                )}
                <div class="absolute inset-x-0 bottom-0 p-4 text-white">
                  <h3 class="text-xl font-bold">{p.name}</h3>
                  <p class="text-sm text-white/85">
                    {p.gender} • {p.duration}
                  </p>
                </div>
              </div>

              <div class="flex flex-1 flex-col p-5">
                <ul class="mb-4 flex flex-wrap gap-2 text-xs font-semibold text-blue">
                  <li class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1">
                    <Icon name="user" class="size-3.5" /> {p.level}
                  </li>
                  <li class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1">
                    <Icon name="clock" class="size-3.5" /> {p.time}
                  </li>
                  <li class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1">
                    <Icon name="bolt" class="size-3.5" /> {p.type}
                  </li>
                </ul>
                <p class="text-sm text-darkblue/80">{p.description}</p>

                <details class="group mt-4 rounded-xl bg-white">
                  <summary class="flex min-h-11 items-center justify-between gap-2 px-4 py-2 text-sm font-semibold text-blue">
                    O que inclui
                    <Icon name="plus" class="details-icon size-4 transition-transform" />
                  </summary>
                  <ul class="space-y-3 px-4 pb-4 text-sm">
                    {p.features.map((f) => (
                      <li class:list={[f.highlight && 'rounded-lg bg-gold/15 p-3']}>
                        <p class="font-semibold text-darkblue">{f.title}</p>
                        <p class="text-darkblue/75">{f.description}</p>
                      </li>
                    ))}
                  </ul>
                </details>

                <div class="mt-auto pt-5">
                  <WhatsAppLink interest={p.name} class="btn-dark">
                    Começar agora
                  </WhatsAppLink>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <CarouselControls target="programas-lista" label="Programas" />
    <p class="mt-2 text-center text-xs text-blue md:hidden" aria-hidden="true">Desliza para ver mais →</p>
  </div>
</section>
